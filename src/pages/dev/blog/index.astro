---
import { getCollection } from 'astro:content';
import ShellLayout from '../../../layouts/ShellLayout.astro';
import { readingTime } from '../../../lib/reading-time';
import { META } from '../../../config/content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const dateLabel = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
---

<ShellLayout
  title={META.blog.title}
  description={META.blog.description}
  activeFile="blog-index"
  breadcrumb={[{ label: 'README.md', href: '/dev' }, { label: 'blog/' }]}
>
  <h1 class="font-display text-2xl font-bold text-fog mb-6"># Blog ({posts.length})</h1>

  {posts.length > 0 ? posts.map(post => (
    <a href={`/dev/blog/${post.id}`} class="block py-3 border-t border-jungle/10 group">
      <div class="flex items-baseline gap-3">
        <span class="text-fog/40 text-xs w-24 shrink-0">{dateLabel(post.data.date)}</span>
        <span class="text-fog/90 group-hover:text-mint transition-colors">{post.data.title}</span>
        <span class="text-fog/30 text-xs shrink-0">-rw-r--r-- {readingTime(post.body)}K</span>
      </div>
      <p class="pl-27 text-fog/50 text-xs mt-1">{post.data.description}</p>
    </a>
  )) : (
    <p class="text-fog/40 italic">No posts yet — check back soon.</p>
  )}
</ShellLayout>
