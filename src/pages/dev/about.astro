---
import ShellLayout from '../../layouts/ShellLayout.astro';
import ProfileTerminal from '../../components/ProfileTerminal.astro';
import TerminalBar from '../../components/TerminalBar.astro';
import { SITE, TOPICS } from '../../config/site';
import { META, BIO } from '../../config/content';
---

<ShellLayout
  title="About"
  description={META.about.description}
  activeFile="about"
  breadcrumb={[{ label: 'README.md', href: '/dev' }, { label: 'about.md' }]}
>
  <h1 class="font-display text-3xl font-bold text-fog mb-1"># About</h1>
  <p class="text-jungle mb-8">{BIO.sectionHeading}</p>

  <div class="max-w-64 mb-8 border border-jungle/20 rounded-lg overflow-hidden">
    <TerminalBar label="jeroen-van-erp.jpg" />
    <img src="/jeroen-van-erp.jpg" alt="Jeroen van Erp" class="w-full h-auto block" width="320" height="320" />
  </div>

  <ProfileTerminal />

  <div class="mt-8 flex flex-wrap items-center gap-4 text-sm text-fog/70">
    <span>📍 {SITE.location}</span>
    <span>🗣 Speaks: {SITE.languages.join(' & ')}</span>
    <span title="Also: SUSE Rancher enthusiast">🐑 Rancher at heart</span>
  </div>

  <div class="mt-10">
    <h2 class="text-mint font-display text-lg mb-3">## Topics I cover</h2>
    <div class="flex flex-wrap gap-2">
      {TOPICS.map(topic => (
        <span class="text-xs border border-jungle/25 text-fog/70 px-2 py-0.5 rounded">{topic}</span>
      ))}
    </div>
  </div>

  <div class="mt-10">
    <h2 class="text-mint font-display text-lg mb-3">## Currently at</h2>
    <div class="inline-flex items-center gap-3 border border-jungle/20 rounded-lg px-4 py-3">
      <div class="w-8 h-8 rounded bg-jungle flex items-center justify-center shrink-0">
        <span class="text-pine text-xs font-bold">S</span>
      </div>
      <div>
        <p class="text-fog font-semibold text-sm">SUSE</p>
        <p class="text-fog/60 text-xs">The world's largest independent open source company</p>
      </div>
    </div>
    <p class="mt-4 text-fog/70 leading-relaxed max-w-xl">{BIO.suseRole}</p>
  </div>

  <div class="mt-10">
    <div class="flex items-baseline justify-between mb-3">
      <h2 class="text-mint font-display text-lg">## Press bio</h2>
      <span class="text-xs text-fog/40">≤ 500 characters</span>
    </div>
    <div class="border border-jungle/20 rounded-lg p-4 mb-3">
      <p id="press-bio-text" class="text-fog/80 leading-relaxed">{BIO.press}</p>
    </div>
    <button
      id="copy-bio-btn"
      class="flex items-center gap-2 text-sm font-medium text-mint hover:underline underline-offset-2 transition-colors"
    >
      <svg class="w-4 h-4 js-copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
      </svg>
      <svg class="w-4 h-4 js-check-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
      <span class="js-copy-label">Copy to clipboard</span>
    </button>
  </div>

  <script>
    function initPressBio() {
      const btn = document.getElementById('copy-bio-btn');
      const text = document.getElementById('press-bio-text');
      if (!btn || !text) return;
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';

      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(text.textContent?.trim() ?? '');
        } catch {
          const el = document.createElement('textarea');
          el.value = text.textContent?.trim() ?? '';
          el.style.cssText = 'position:fixed;opacity:0';
          document.body.appendChild(el);
          el.select();
          document.execCommand('copy');
          document.body.removeChild(el);
        }
        const copyIcon = btn.querySelector('.js-copy-icon');
        const checkIcon = btn.querySelector('.js-check-icon');
        const label = btn.querySelector('.js-copy-label');
        copyIcon?.classList.add('hidden');
        checkIcon?.classList.remove('hidden');
        if (label) label.textContent = 'Copied!';
        setTimeout(() => {
          copyIcon?.classList.remove('hidden');
          checkIcon?.classList.add('hidden');
          if (label) label.textContent = 'Copy to clipboard';
        }, 2000);
      });
    }

    initPressBio();
    document.addEventListener('astro:page-load', initPressBio);
  </script>
</ShellLayout>
