---
import Layout from '../layouts/Layout.astro';
import { META } from '../config/content';
import TerminalBar from '../components/TerminalBar.astro';

const routes = [
  { href: '/', label: 'home' },
  { href: '/about', label: 'about' },
  { href: '/talks', label: 'talks' },
  { href: '/blog', label: 'blog' },
  { href: '/writing', label: 'writing' },
  { href: '/topics', label: 'topics' },
];
---

<Layout title={META.notFound.title} description={META.notFound.description}>
  <section class="hero-surface py-24 sm:py-32 min-h-[60vh] flex items-center">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="tech:hidden text-mint text-xs font-semibold tracking-[0.2em] uppercase mb-4">404</p>
      <h1 class="tech:hidden font-display text-4xl sm:text-5xl font-bold text-white mb-6">Page not found</h1>
      <p class="tech:hidden text-fog/65 text-lg mb-10">
        The page you were looking for doesn't exist or has been moved.
      </p>

      <div class="hidden tech:block text-left bg-pine border border-jungle/20 rounded-xl overflow-hidden mb-10">
        <TerminalBar label="404.sh" />
        <div class="p-6 font-sans text-sm leading-relaxed">
          <p class="text-mint mb-1">$ cat <span class="js-notfound-path">.</span></p>
          <p class="text-persimmon mb-4">bash: <span class="js-notfound-path">.</span>: No such file or directory</p>
          <p class="text-jungle mb-2">$ ls ~/</p>
          <ul class="grid grid-cols-2 sm:grid-cols-3 gap-x-6 gap-y-1.5 pl-4 text-fog/85">
            {routes.map(route => (
              <li>
                <a href={route.href} class="hover:text-mint hover:underline underline-offset-2">{route.label}</a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="flex flex-wrap gap-4 justify-center">
        <a
          href="/"
          class="inline-flex items-center gap-2 bg-persimmon hover:bg-persimmon/90 text-white font-semibold px-6 py-3 rounded-lg transition-colors"
        >
          Go home
        </a>
        <a
          href="/talks"
          class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white font-semibold px-6 py-3 rounded-lg transition-colors"
        >
          Browse talks
        </a>
      </div>
    </div>
  </section>

  <script>
    // Static 404 page — Astro.url.pathname would only ever resolve to the
    // build-time /404 route, not the real mistyped URL a visitor hit, so the
    // attempted path is filled in client-side from the actual address bar.
    function fillNotFoundPath() {
      const path = window.location.pathname;
      document.querySelectorAll('.js-notfound-path').forEach(el => { el.textContent = path; });
    }
    fillNotFoundPath();
    document.addEventListener('astro:page-load', fillNotFoundPath);
  </script>
</Layout>
