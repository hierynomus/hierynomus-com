---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import BootSequence from '../components/BootSequence.astro';
import NavProgress from '../components/NavProgress.astro';
import CommandPalette from '../components/CommandPalette.astro';
import { SITE, SOCIAL } from '../config/site';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = SITE.description,
  ogImage = '/og/default.png',
} = Astro.props;


const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={`${title} | Jeroen van Erp`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site ?? SITE.url).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SOCIAL.twitterHandle} />
    <meta name="twitter:creator" content={SOCIAL.twitterHandle} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site ?? SITE.url).toString()} />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} Blog`} href="/rss.xml" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" href="/favicon-192.png" sizes="192x192" />

    <!-- Fonts are self-hosted via @fontsource (see global.css) — no external request -->

    <title>{title} | Jeroen van Erp</title>

    <slot name="head" />

    <ClientRouter />

    <!-- Dark mode + site theme: run before paint to prevent flash on first load.
         Corp and tech are separate route trees (src/lib/theme.ts) now, not a
         CSS toggle on one page — a stored "tech" preference means this corp
         page isn't the right one at all, so redirect to its /dev equivalent
         before doing anything else. -->
    <script is:inline>
      (function () {
        function syncCorpThemeState() {
          const storedSiteTheme = localStorage.getItem('site-theme');
          // The guard matters specifically for 404.astro: it's the one corp
          // page reachable at *any* URL, including a dead /dev/... link — so
          // location.pathname can already start with /dev here. Without the
          // guard that becomes /dev/dev/..., itself a 404, redirecting again
          // to /dev/dev/dev/..., forever.
          if (storedSiteTheme === 'tech' && !location.pathname.startsWith('/dev')) {
            location.replace(location.pathname === '/' ? '/dev' : `/dev${location.pathname}`);
            return;
          }

          // A bfcache-restored corp page (browser Back button after
          // ThemeSwitcher.goTech() set this live, right before it navigated
          // away) can resume with data-site-theme="tech" still attached —
          // clear it so tech: CSS variants can't stay active on corp markup
          // that has no tech equivalent to show in their place.
          delete document.documentElement.dataset.siteTheme;

          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', stored === 'dark' || (!stored && prefersDark));
        }

        syncCorpThemeState();
        // bfcache restores don't re-run this script from scratch, but this
        // listener itself survives the freeze/thaw and does fire again.
        window.addEventListener('pageshow', (e) => { if (e.persisted) syncCorpThemeState(); });
      })();
    </script>

    <!-- Site theme: redirect SPA navigations away from corp to their /dev
         equivalent when "tech" is stored. astro:before-preparation is the
         correct hook for this — it's the one ClientRouter transition event
         that's actually cancelable, fires before any fetch, and lets us
         redirect cleanly by mutating event.to in place so the router's own
         navigation machinery completes the transition to the new
         destination. (An earlier version of this did the redirect from
         astro:before-swap via location.replace() — that event isn't
         cancelable, so Astro's own history.pushState to the ORIGINAL
         destination runs synchronously right after and non-deterministically
         stomps on the manual redirect; it happened to look like it worked in
         casual testing but is fundamentally racy.) -->
    <script>
      document.addEventListener('astro:before-preparation', (e) => {
        const prepEvent = e as TransitionBeforePreparationEvent;
        const storedSiteTheme = localStorage.getItem('site-theme');
        const toPathname = prepEvent.to.pathname;
        // The guard matters specifically for 404.astro: it's the one corp
        // page reachable at *any* URL, including a dead /dev/... link — so
        // toPathname can already start with /dev here. Without the guard
        // that becomes /dev/dev/..., itself a 404, redirecting again to
        // /dev/dev/dev/..., forever.
        if (storedSiteTheme === 'tech' && !toPathname.startsWith('/dev')) {
          prepEvent.to.pathname = toPathname === '/' ? '/dev' : `/dev${toPathname}`;
        }
      });
    </script>

    <!-- Dark mode: persist across ClientRouter navigations. astro:before-swap
         fires before the DOM is replaced, giving us access to
         event.newDocument so we can apply it before first paint. -->
    <script>
      document.addEventListener('astro:before-swap', (e) => {
        const newHtml = (e as TransitionBeforeSwapEvent).newDocument.documentElement;

        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          newHtml.classList.add('dark');
        }
      });
    </script>
  </head>
  <body class="min-h-screen bg-white dark:bg-pine text-pine dark:text-fog transition-colors duration-200">
    <NavProgress />
    <BootSequence />
    <CommandPalette />
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
