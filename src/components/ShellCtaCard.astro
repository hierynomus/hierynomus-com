---
// The /dev shell's version of SpeakingCtaCard.astro — same props/API, but
// styled flat and bordered to match the shell's editor aesthetic instead of
// reusing the corp marketing pages' .hero-surface gradient/glow treatment,
// and links to /dev#contact instead of the corp homepage's /#contact anchor.
import { CTA } from '../config/content';

interface Props {
  heading?: string;
  subtext?: string;
}

const {
  heading = CTA.talk.heading,
  subtext = CTA.talk.subtext,
} = Astro.props;
---

<div class="border border-jungle/20 rounded-lg p-5">
  <p class="text-fog font-display font-semibold text-sm mb-2">{heading}</p>
  <p class="text-fog/60 text-xs mb-4 leading-relaxed">{subtext}</p>
  <a
    href="/dev#contact"
    class="inline-flex w-full justify-center items-center gap-2 bg-persimmon hover:bg-persimmon/90 text-pine text-sm font-semibold px-4 py-2.5 rounded transition-colors"
  >
    Get in Touch
  </a>
</div>
