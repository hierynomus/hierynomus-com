---
import TerminalBar from './TerminalBar.astro';
---

<!-- Tech-theme-only command palette. Rendered on every page but only ever
     opened by its own script, and only while data-site-theme="tech" — corp
     visitors never see it and the global keydown listener no-ops for them. -->
<div
  id="command-palette-backdrop"
  class="hidden fixed inset-0 z-[300] items-start justify-center bg-pine/80 backdrop-blur-sm pt-[15vh] px-4"
>
  <div
    id="command-palette"
    role="dialog"
    aria-modal="true"
    aria-label="Quick navigation"
    class="w-full max-w-lg bg-pine border border-jungle/30 rounded-xl overflow-hidden shadow-lg"
  >
    <TerminalBar label="command-palette" />
    <div class="flex items-center gap-2 px-4 py-3 border-b border-jungle/15">
      <span class="text-jungle font-sans">$</span>
      <input
        id="command-palette-input"
        type="text"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        placeholder="Type a command or search…"
        class="flex-1 bg-transparent font-sans text-fog placeholder:text-fog/40 outline-none"
      />
      <kbd class="text-xs text-fog/40 border border-fog/20 rounded px-1.5 py-0.5">Esc</kbd>
    </div>
    <ul id="command-palette-results" class="max-h-80 overflow-y-auto py-2 font-sans text-sm"></ul>
  </div>
</div>

<script>
  import { navigate } from 'astro:transitions/client';
  import { SOCIAL } from '../config/site';

  type Command = {
    label: string;
    hint?: string;
    href?: string;
    external?: boolean;
    action?: () => void;
  };

  const commands: Command[] = [
    { label: 'Home', href: '/' },
    { label: 'About', href: '/about' },
    { label: 'Talks', href: '/talks' },
    { label: 'Blog', href: '/blog' },
    { label: 'Writing', href: '/writing' },
    { label: 'Topics', href: '/topics' },
    { label: 'Projects', href: '/#projects' },
    { label: 'Contact', href: '/#contact' },
    { label: 'GitHub', hint: '↗', href: SOCIAL.github, external: true },
    { label: 'LinkedIn', hint: '↗', href: SOCIAL.linkedin, external: true },
    {
      label: 'Switch to corp theme',
      action: () => {
        localStorage.setItem('site-theme', 'corp');
        delete document.documentElement.dataset.siteTheme;
      },
    },
  ];

  let activeIndex = 0;
  let filtered = commands;
  let lastFocused: HTMLElement | null = null;

  function isTech() {
    return document.documentElement.dataset.siteTheme === 'tech';
  }

  function render() {
    const list = document.getElementById('command-palette-results');
    if (!list) return;
    list.innerHTML = '';
    filtered.forEach((cmd, i) => {
      const li = document.createElement('li');
      li.dataset.index = String(i);
      li.className = [
        'flex items-center justify-between gap-4 px-4 py-2 cursor-pointer',
        i === activeIndex ? 'bg-jungle/15 text-mint' : 'text-fog/85',
      ].join(' ');
      const label = document.createElement('span');
      label.textContent = cmd.label;
      li.appendChild(label);
      if (cmd.hint) {
        const hint = document.createElement('span');
        hint.className = 'text-fog/40 text-xs';
        hint.textContent = cmd.hint;
        li.appendChild(hint);
      }
      li.addEventListener('mouseenter', () => { activeIndex = i; render(); });
      li.addEventListener('click', () => run(cmd));
      list.appendChild(li);
    });
  }

  function run(cmd: Command) {
    close();
    if (cmd.action) {
      cmd.action();
    } else if (cmd.href && cmd.external) {
      window.open(cmd.href, '_blank', 'noopener,noreferrer');
    } else if (cmd.href) {
      navigate(cmd.href);
    }
  }

  function open() {
    if (!isTech()) return;
    const backdrop = document.getElementById('command-palette-backdrop');
    const input = document.getElementById('command-palette-input') as HTMLInputElement | null;
    if (!backdrop || !input) return;
    lastFocused = document.activeElement as HTMLElement | null;
    backdrop.classList.remove('hidden');
    backdrop.classList.add('flex');
    input.value = '';
    filtered = commands;
    activeIndex = 0;
    render();
    input.focus();
  }

  function close() {
    const backdrop = document.getElementById('command-palette-backdrop');
    if (!backdrop) return;
    backdrop.classList.add('hidden');
    backdrop.classList.remove('flex');
    lastFocused?.focus();
  }

  function isOpen() {
    return !document.getElementById('command-palette-backdrop')?.classList.contains('hidden');
  }

  function initPalette() {
    const backdrop = document.getElementById('command-palette-backdrop');
    const input = document.getElementById('command-palette-input') as HTMLInputElement | null;
    const trigger = document.getElementById('command-palette-trigger');
    if (!backdrop || !input || backdrop.dataset.bound) return;
    backdrop.dataset.bound = '1';

    backdrop.addEventListener('click', e => { if (e.target === backdrop) close(); });

    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      filtered = q ? commands.filter(c => c.label.toLowerCase().includes(q)) : commands;
      activeIndex = 0;
      render();
    });

    input.addEventListener('keydown', e => {
      if (e.key === 'Escape') { e.preventDefault(); close(); }
      else if (e.key === 'ArrowDown') { e.preventDefault(); activeIndex = Math.min(activeIndex + 1, filtered.length - 1); render(); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); activeIndex = Math.max(activeIndex - 1, 0); render(); }
      else if (e.key === 'Enter') { e.preventDefault(); if (filtered[activeIndex]) run(filtered[activeIndex]); }
    });

    trigger?.addEventListener('click', open);
  }

  document.addEventListener('keydown', e => {
    if (!isTech()) return;
    const target = e.target as HTMLElement | null;
    const inEditable = target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable);

    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      isOpen() ? close() : open();
    } else if (e.key === '/' && !inEditable && !isOpen()) {
      e.preventDefault();
      open();
    }
  });

  initPalette();
  document.addEventListener('astro:page-load', initPalette);
</script>
